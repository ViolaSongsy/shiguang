OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional locally. Required for Vercel/cloud deployment with Turso.
# Example: libsql://your-database-your-org.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Required for password reset links in production.
APP_URL=http://localhost:3000

# Optional locally. Required to send real password reset emails in production.
RESEND_API_KEY=
EMAIL_FROM=拾光 <onboarding@resend.dev>

# Optional: configure only when a trusted hosting proxy overwrites this header.
# For Vercel, you may use x-vercel-forwarded-for. Never use a client-controlled header.
# If unset, limits fall back to hashed email, user ID, or reset-token identities.
# Configure a trusted proxy in production to also limit abuse across many accounts.
TRUSTED_PROXY_IP_HEADER=
